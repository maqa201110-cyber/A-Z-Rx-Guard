cat << 'EOF' > main.py
import os
import uuid
from flask import Flask, request, render_template_string, redirect, url_for, session

app = Flask(__name__, static_folder='static')
app.secret_key = 'maqa_shop_secret_key'

# Yüksek çözünürlüklü fotoğraflar için max 32MB yükleme sınırı
app.config['MAX_CONTENT_LENGTH'] = 32 * 1024 * 1024

UPLOAD_FOLDER = os.path.join(app.root_path, 'static', 'uploads')
ALLOWED_EXTENSIONS = {'png', 'jpg', 'jpeg', 'gif', 'webp', 'heic'}
app.config['UPLOAD_FOLDER'] = UPLOAD_FOLDER

os.makedirs(UPLOAD_FOLDER, exist_ok=True)

def allowed_file(filename):
    return '.' in filename and filename.rsplit('.', 1)[1].lower() in ALLOWED_EXTENSIONS

users_db = {"admin": "123456"}
listings = []

AUTH_HTML = """
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAQA Shop - Giriş & Kayıt</title>
    <style>
        * { box-sizing: border-box; }
        body { background-color: #0f172a; color: #f8fafc; font-family: system-ui, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 20px; }
        .auth-card { background: #1e293b; padding: 2rem; border-radius: 16px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); width: 100%; max-width: 380px; border: 1px solid #334155; }
        h2 { color: #38bdf8; margin: 0 0 1.5rem 0; text-align: center; font-size: 1.8rem; }
        .tabs { display: flex; margin-bottom: 1.5rem; background: #0f172a; border-radius: 8px; padding: 4px; }
        .tab { flex: 1; text-align: center; padding: 8px; cursor: pointer; border-radius: 6px; font-weight: 600; color: #94a3b8; }
        .tab.active { background: #0284c7; color: white; }
        .form-group { margin-bottom: 1rem; position: relative; }
        input { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #fff; outline: none; }
        .toggle-password { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; font-size: 1.1rem; }
        .btn { width: 100%; padding: 12px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; }
        .btn-primary { background: #0284c7; color: white; margin-top: 0.5rem; }
        .msg { font-size: 0.85rem; text-align: center; margin-top: 1rem; }
        .error { color: #f87171; }
        .success { color: #4ade80; }
        .hidden { display: none; }
    </style>
</head>
<body>
    <div class="auth-card">
        <h2>🛍️ MAQA Shop</h2>
        <div class="tabs">
            <div class="tab {% if active_tab == 'login' %}active{% endif %}" onclick="switchTab('login')">Giriş Yap</div>
            <div class="tab {% if active_tab == 'register' %}active{% endif %}" onclick="switchTab('register')">Kayıt Ol</div>
        </div>
        <form id="login-form" class="{% if active_tab == 'register' %}hidden{% endif %}" method="POST" action="/login">
            <div class="form-group"><input type="text" name="username" placeholder="Kullanıcı Adı" required></div>
            <div class="form-group">
                <input type="password" id="login-pass" name="password" placeholder="Şifre" required>
                <span class="toggle-password" onclick="togglePass('login-pass', this)">👁️</span>
            </div>
            <button type="submit" class="btn btn-primary">Giriş Yap</button>
        </form>
        <form id="register-form" class="{% if active_tab != 'register' %}hidden{% endif %}" method="POST" action="/register">
            <div class="form-group"><input type="text" name="username" placeholder="Kullanıcı Adı Oluştur" required></div>
            <div class="form-group">
                <input type="password" id="reg-pass" name="password" placeholder="Şifre Oluştur" required>
                <span class="toggle-password" onclick="togglePass('reg-pass', this)">👁️</span>
            </div>
            <button type="submit" class="btn btn-primary">Kayıt Ol</button>
        </form>
        {% if error %}<p class="msg error">{{ error }}</p>{% endif %}
        {% if success %}<p class="msg success">{{ success }}</p>{% endif %}
    </div>
    <script>
        function togglePass(id, icon) {
            const input = document.getElementById(id);
            if (input.type === "password") { input.type = "text"; icon.textContent = "🙈"; }
            else { input.type = "password"; icon.textContent = "👁️"; }
        }
        function switchTab(tab) {
            const loginForm = document.getElementById('login-form');
            const regForm = document.getElementById('register-form');
            const tabs = document.querySelectorAll('.tab');
            if (tab === 'login') {
                loginForm.classList.remove('hidden'); regForm.classList.add('hidden');
                tabs[0].classList.add('active'); tabs[1].classList.remove('active');
            } else {
                loginForm.classList.add('hidden'); regForm.classList.remove('hidden');
                tabs[0].classList.remove('active'); tabs[1].classList.add('active');
            }
        }
    </script>
</body>
</html>
"""

SHOP_HTML = """
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAQA Shop - CPM Araba Pazarı</title>
    <style>
        * { box-sizing: border-box; }
        body { background-color: #0f172a; color: #f8fafc; font-family: system-ui, sans-serif; margin: 0; padding: 15px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #1e293b; padding: 15px 20px; border-radius: 12px; border: 1px solid #334155; margin-bottom: 20px; }
        h1 { margin: 0; color: #38bdf8; font-size: 1.4rem; }
        .btn { padding: 8px 16px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; font-size: 0.9rem; }
        .btn-danger { background: #ef4444; color: white; }
        .btn-primary { background: #0284c7; color: white; }
        .btn-delete { background: #dc2626; color: white; padding: 4px 10px; font-size: 0.75rem; border-radius: 6px; position: absolute; top: 12px; right: 12px; text-decoration: none; z-index: 20; }
        
        .card { background: #1e293b; padding: 20px; border-radius: 12px; border: 1px solid #334155; margin-bottom: 20px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        @media(max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }
        
        input, select, textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #fff; margin-bottom: 10px; outline: none; }
        
        .file-label { display: block; background: #0f172a; border: 1px dashed #38bdf8; padding: 14px; border-radius: 8px; text-align: center; color: #38bdf8; cursor: pointer; font-size: 0.95rem; margin-bottom: 10px; font-weight: bold; }
        
        .market-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
        .item-card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 15px; position: relative; overflow: hidden; }
        
        /* SLIDER / FOTO GALERİ */
        .slider-container { width: 100%; height: 220px; position: relative; border-radius: 10px; overflow: hidden; margin-bottom: 12px; background: #0f172a; border: 1px solid #334155; }
        .slider-wrapper { display: flex; width: 100%; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
        .slider-wrapper::-webkit-scrollbar { display: none; }
        .slide-img { min-width: 100%; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start; }
        .photo-count-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.75); color: #fff; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; pointer-events: none; border: 1px solid #475569; }
        
        .no-img-box { width: 100%; height: 180px; background: #0f172a; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.9rem; margin-bottom: 12px; border: 1px dashed #334155; }

        .badge { display: inline-block; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: bold; margin-right: 5px; margin-bottom: 5px; }
        .badge-type { background: #0284c7; color: white; }
        .badge-tag { background: #334155; color: #38bdf8; border: 1px solid #0284c7; }
        .price { font-size: 1.25rem; color: #4ade80; font-weight: bold; margin: 10px 0; background: #0f172a; padding: 8px 12px; border-radius: 8px; border: 1px solid #22c55e; display: inline-block; }
        .info-row { font-size: 0.88rem; color: #cbd5e1; margin-bottom: 6px; }
        .contact-btn { background: #22c55e; color: #000; text-align: center; width: 100%; margin-top: 10px; font-weight: bold; display: block; text-decoration: none; padding: 10px; border-radius: 8px; }
        .empty-msg { text-align: center; color: #64748b; padding: 30px; font-size: 1.1rem; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🛍️ MAQA Shop (CPM Pazarı)</h1>
        <div>
            <span style="margin-right:10px;">👤 <strong>{{ user }}</strong></span>
            <a href="/logout" class="btn btn-danger">Çıkış</a>
        </div>
    </div>

    <!-- İLAN EKLEME FORMU -->
    <div class="card">
        <h3 style="margin-top:0; color:#38bdf8;">➕ Yeni Araba / İlan Ekle</h3>
        <form action="/add-listing" method="POST" enctype="multipart/form-data">
            <div class="form-grid">
                <input type="text" name="title" placeholder="İlan Başlığı (Örn: BMW E60 V10 M5)" required>
                <input type="text" name="model" placeholder="Araç Modeli (Örn: BMW E60)" required>
                <input type="text" name="hp" placeholder="HP / Tork (Örn: 1690 HP / 2250 NM)" required>
                <select name="type">
                    <option value="Satılık">Sadece Satılık</option>
                    <option value="Takaslı">Sadece Takaslı</option>
                    <option value="Satılık & Takaslı">Satılık & Takaslı</option>
                </select>
                <input type="text" name="price" placeholder="Fiyat (Örn: 10.000.000 CPM$)" required>
                <input type="text" name="cpm_id" placeholder="CPM Oyun ID'niz" required>
                <input type="text" name="contact" placeholder="Telegram Kullanıcı Adınız (Örn: Maqa343)" required>
            </div>
            
            <label class="file-label" for="car_photos_input">
                <span id="file-label-text">📷 Galeriden Fotoğraf Seç (Max 15 Tane)</span>
                <input type="file" id="car_photos_input" name="car_photos" accept="image/*" multiple style="display:none;" onchange="updateFileLabel(this)">
            </label>

            <input type="text" name="tags" placeholder="Etiketler (Virgülle ayırın: Chrome, W16, Drift)">
            <textarea name="desc" rows="2" placeholder="Araç hakkında detaylar, vites ayarları vb."></textarea>
            <button type="submit" class="btn btn-primary" style="width: 100%;">İlanı Yayınla 🔥</button>
        </form>
    </div>

    <!-- İLANLAR LİSTESİ -->
    <h3 style="color:#f8fafc;">🔥 Güncel CPM Araba & Takas İlanları</h3>
    <div class="market-grid">
        {% if not listings %}
            <div class="empty-msg">Henüz hiç ilan yok. İlk ilanı sen ekle! 🚀</div>
        {% endif %}

        {% for item in listings %}
        <div class="item-card">
            {% if item.seller == user or user == 'admin' %}
                <a href="/delete-listing/{{ item.id }}" class="btn-delete" onclick="return confirm('Bu ilanı silmek istediğinize emin misiniz?')">🗑️ Sil</a>
            {% endif %}

            <!-- KAYDIRMALI FOTO GALERİ -->
            {% if item.images and item.images|length > 0 %}
                <div class="slider-container">
                    <div class="slider-wrapper">
                        {% for img in item.images %}
                            <img src="/static/uploads/{{ img }}" class="slide-img" alt="Araç Fotoğrafı">
                        {% endfor %}
                    </div>
                    {% if item.images|length > 1 %}
                        <div class="photo-count-badge">↔️ 1 / {{ item.images|length }} Foto (Sağa kaydır)</div>
                    {% endif %}
                </div>
            {% else %}
                <div class="no-img-box">🖼️ Fotoğraf Eklenmedi</div>
            {% endif %}

            <div>
                <span class="badge badge-type">{{ item.type }}</span>
                {% for tag in item.tags %}
                    <span class="badge badge-tag">{{ tag }}</span>
                {% endfor %}
            </div>
            <h3 style="margin: 10px 0 5px 0; color:#fff;">{{ item.title }}</h3>
            <div class="info-row">🏎️ <strong>Model:</strong> {{ item.model }}</div>
            <div class="info-row">⚡ <strong>Güç:</strong> {{ item.hp }}</div>
            <div class="info-row">🆔 <strong>CPM ID:</strong> <code style="color:#38bdf8;">{{ item.cpm_id }}</code></div>
            <div class="info-row">👤 <strong>Satıcı:</strong> {{ item.seller }}</div>
            
            <div class="price">{{ item.price }}</div>
            
            {% if item.desc %}
            <p style="font-size:0.85rem; color:#cbd5e1; background:#0f172a; padding:8px; border-radius:6px; margin: 8px 0;">{{ item.desc }}</p>
            {% endif %}
            
            <a href="https://t.me/{{ item.contact.replace('@', '') }}" target="_blank" class="contact-btn">💬 Telegram'dan İletişime Geç</a>
        </div>
        {% endfor %}
    </div>

    <script>
        function updateFileLabel(input) {
            const labelText = document.getElementById('file-label-text');
            if (input.files.length > 15) {
                alert("En fazla 15 fotoğraf seçebilirsiniz!");
                input.value = "";
                labelText.innerText = "📷 Galeriden Fotoğraf Seç (Max 15 Tane)";
            } else if (input.files.length > 0) {
                labelText.innerText = '✅ ' + input.files.length + ' Fotoğraf Seçildi';
            } else {
                labelText.innerText = "📷 Galeriden Fotoğraf Seç (Max 15 Tane)";
            }
        }
    </script>
</body>
</html>
"""

@app.route('/')
def index():
    if session.get('logged_in'):
        return render_template_string(SHOP_HTML, user=session.get('user'), listings=listings)
    return redirect(url_for('login'))

@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        username = request.form.get('username')
        password = request.form.get('password')
        if username in users_db and users_db[username] == password:
            session['logged_in'] = True
            session['user'] = username
            return redirect(url_for('index'))
        return render_template_string(AUTH_HTML, active_tab='login', error="Kullanıcı adı veya şifre hatalı!")
    return render_template_string(AUTH_HTML, active_tab='login')

@app.route('/register', methods=['POST'])
def register():
    username = request.form.get('username')
    password = request.form.get('password')
    if username in users_db:
        return render_template_string(AUTH_HTML, active_tab='register', error="Bu kullanıcı adı zaten alınmış!")
    users_db[username] = password
    return render_template_string(AUTH_HTML, active_tab='login', success="Kayıt başarılı! Giriş yapabilirsiniz.")

@app.route('/add-listing', methods=['POST'])
def add_listing():
    if not session.get('logged_in'):
        return redirect(url_for('index'))
    
    tags_raw = request.form.get('tags', '')
    tags_list = [t.strip() for t in tags_raw.split(',') if t.strip()]

    # Dosya Yükleme İşlemi
    saved_images = []
    if 'car_photos' in request.files:
        uploaded_files = request.files.getlist('car_photos')
        for file in uploaded_files[:15]:
            if file and file.filename != '':
                ext = file.filename.rsplit('.', 1)[-1].lower() if '.' in file.filename else 'jpg'
                unique_name = f"{uuid.uuid4().hex[:10]}.{ext}"
                filepath = os.path.join(app.config['UPLOAD_FOLDER'], unique_name)
                file.save(filepath)
                saved_images.append(unique_name)

    new_item = {
        "id": len(listings) + 1,
        "title": request.form.get('title'),
        "model": request.form.get('model'),
        "hp": request.form.get('hp'),
        "type": request.form.get('type'),
        "price": request.form.get('price'),
        "cpm_id": request.form.get('cpm_id'),
        "contact": request.form.get('contact'),
        "images": saved_images,
        "seller": session.get('user'),
        "tags": tags_list,
        "desc": request.form.get('desc')
    }
    listings.insert(0, new_item)
    return redirect(url_for('index'))

@app.route('/delete-listing/<int:item_id>')
def delete_listing(item_id):
    if not session.get('logged_in'):
        return redirect(url_for('index'))
    
    global listings
    listings = [item for item in listings if not (item['id'] == item_id and (item['seller'] == session.get('user') or session.get('user') == 'admin'))]
    return redirect(url_for('index'))

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('index'))

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
EOF
